import Toybox.Lang;
import Toybox.Test;

//! The web configurator previews the face on a lattice exported by
//! tools/geometry_export.py, not on one it draws itself. These pin that export
//! to the DotGrid this build actually made: how many dots each ring holds, and
//! how many of them take each cross orientation. The block below is generated
//! by the exporter; the counts here are derived independently, by the watch.
module GeometryTest {

    // --- generated by tools/geometry_export.py: do not edit ---
    //! Per lattice: the screen, 1 if the hub has dots, dots per ring outermost
    //! first, then dots per (ring, ARMS row), ring-major.
    const RING_DOTS = [
        390, 1, 436, 340, 224, 124, 104, 108, 116, 108, 88, 84, 84, 84, 56, 60, 48, 60, 24, 32, 36, 32,
        390, 0, 436, 340, 224, 112, 104, 108, 116, 108, 88, 84, 84, 84, 56, 60, 48, 60, 24, 28, 32, 28,
        416, 1, 500, 396, 244, 148, 112, 132, 124, 132, 104, 92, 108, 92, 56, 64, 60, 64, 32, 40, 36, 40,
        454, 1, 556, 400, 276, 164, 144, 140, 132, 140, 88, 104, 104, 104, 72, 68, 68, 68, 32, 44, 44, 44
    ] as Array<Number>;
    // --- end of generated counts ---

    const ROW = 2 + StatMap.RINGS * (1 + DotGrid.ORIENTATIONS);

    (:test)
    function theWebPreviewHasThisLatticesDots(logger as Logger) as Boolean {
        DotGrid.build();
        var row = -1;
        for (var i = 0; i < RING_DOTS.size(); i += ROW) {
            if (RING_DOTS[i] == Lattice.SCREEN &&
                    RING_DOTS[i + 1] == (HandStyle.HANDS ? 0 : 1)) {
                row = i;
            }
        }
        Test.assertMessage(row >= 0,
            "no exported lattice for a " + Lattice.SCREEN + " screen");

        for (var ring = 0; ring < StatMap.RINGS; ring++) {
            var from = DotGrid.ringStart[ring];
            var to = DotGrid.ringStart[ring + 1];
            Test.assertEqualMessage(to - from, RING_DOTS[row + 2 + ring],
                "ring " + ring + " holds a different number of dots in the " +
                "web preview");
            var shapes = new [DotGrid.ORIENTATIONS] as Array<Number>;
            for (var k = 0; k < DotGrid.ORIENTATIONS; k++) {
                shapes[k] = 0;
            }
            for (var i = from; i < to; i++) {
                var step = DotGrid.armOf[i] / DotGrid.ARM_VALUES;
                shapes[step] = shapes[step] + 1;
            }
            for (var k = 0; k < DotGrid.ORIENTATIONS; k++) {
                Test.assertEqualMessage(shapes[k],
                    RING_DOTS[row + 2 + StatMap.RINGS +
                              ring * DotGrid.ORIENTATIONS + k],
                    "ring " + ring + " has a different count of orientation " +
                    k + " in the web preview");
            }
        }
        return true;
    }
}

import Toybox.Lang;
import Toybox.Test;

//! The web configurator previews the face on a lattice exported by
//! tools/geometry_export.py, not on one it draws itself. These pin that export
//! to the DotGrid this build actually made: how many dots each ring holds, and
//! how many of them take each cross orientation. The block below is generated
//! by the exporter; the counts here are derived independently, by the watch.
(:test)
module GeometryTest {

    // --- generated by tools/geometry_export.py: do not edit ---
    //! Per lattice: the screen, 1 if the hub has dots, its ring count, dots per
    //! ring outermost first, then dots per (ring, ARMS row), ring-major. Rows
    //! differ in length, since the 454 has five rings.
    const RING_DOTS = [
        390, 1, 4, 484, 356, 208, 76, 0, 160, 164, 160, 0, 120, 116, 120, 0, 68, 72, 68, 0, 24, 28, 24,
        390, 0, 4, 436, 340, 224, 112, 0, 144, 148, 144, 0, 112, 116, 112, 0, 76, 72, 76, 0, 36, 40, 36,
        416, 1, 4, 556, 400, 244, 88, 0, 188, 180, 188, 0, 132, 136, 132, 0, 80, 84, 80, 0, 28, 32, 28,
        454, 1, 5, 516, 380, 284, 164, 52, 0, 172, 172, 172, 0, 128, 124, 128, 0, 92, 100, 92, 0, 56, 52, 56, 0, 16, 20, 16
    ] as Array<Number>;
    // --- end of generated counts ---

    (:test)
    function theWebPreviewHasThisLatticesDots(logger as Logger) as Boolean {
        DotGrid.build();
        // Rows differ in length — the 454 has five rings — so walk them by
        // each row's own ring count rather than a fixed stride.
        var row = -1;
        var at = 0;
        while (at < RING_DOTS.size()) {
            var rings = RING_DOTS[at + 2];
            if (RING_DOTS[at] == Lattice.SCREEN &&
                    RING_DOTS[at + 1] == (HandStyle.HANDS ? 0 : 1)) {
                row = at;
            }
            at += 3 + rings * (1 + DotGrid.ORIENTATIONS);
        }
        Test.assertMessage(row >= 0,
            "no exported lattice for a " + Lattice.SCREEN + " screen");
        Test.assertEqualMessage(RING_DOTS[row + 2], StatMap.RINGS,
            "the web preview has a different number of rings");

        for (var ring = 0; ring < StatMap.RINGS; ring++) {
            var from = DotGrid.ringStart[ring];
            var to = DotGrid.ringStart[ring + 1];
            Test.assertEqualMessage(to - from, RING_DOTS[row + 3 + ring],
                "ring " + ring + " holds a different number of dots in the " +
                "web preview");
            var shapes = new [DotGrid.ORIENTATIONS] as Array<Number>;
            for (var k = 0; k < DotGrid.ORIENTATIONS; k++) {
                shapes[k] = 0;
            }
            for (var i = from; i < to; i++) {
                var step = DotGrid.armOf[i] / DotGrid.ARM_VALUES;
                shapes[step] = shapes[step] + 1;
            }
            for (var k = 0; k < DotGrid.ORIENTATIONS; k++) {
                Test.assertEqualMessage(shapes[k],
                    RING_DOTS[row + 3 + StatMap.RINGS +
                              ring * DotGrid.ORIENTATIONS + k],
                    "ring " + ring + " has a different count of orientation " +
                    k + " in the web preview");
            }
        }
        return true;
    }
}

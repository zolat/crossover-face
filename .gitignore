# Connect IQ build output
bin/
*.prg
*.prg.debug.xml
*.iq

# Developer signing key — never commit
*.der
*.pem
developer_key*

# Editor / OS
.DS_Store
.vscode/settings.json.bak

# Mockup + build output
build/

# Worktrees for parallel sessions. They are checkouts of this same repo, so
# they must never be committed into it — and monkey.jungle's sourcePath is what
# keeps the compiler out of them.
.claude/worktrees/

# Python
__pycache__/

# Device crash-log dumps pulled off the watch
CIQ_LOG*

project.manifest = manifest.xml
project.typecheck = strict

# Say where the source is, rather than letting monkeyc find it.
#
# Left unset, the compiler globs source/** *recursively from the project root* —
# which sweeps in every git worktree under .claude/worktrees/ and compiles a
# second copy of the whole face alongside this one. It fails as a wall of
# "Redefinition of ..." naming files in a sibling branch, which reads like a
# problem with your own tree. Naming the path confines the build to it.
base.sourcePath = source

# One face, five watches. Each device names the full list rather than appending
# to a shared one, because the whole point is that exactly one Lattice and
# exactly one HandStyle reach any given build:
#
#   source-lattice/*  the six screen-dependent constants plus the hand geometry.
#   source-hands/*    what the hands are: brass over the glass, or lit dots.
#
# epix2pro42mm is 390x390, so it takes the Crossover's lattice unchanged and
# differs from it only in having no hands of its own.
instinctcrossoveramoled.sourcePath = $(base.sourcePath);source-lattice/crossover;source-hands/physical
epix2pro42mm.sourcePath = $(base.sourcePath);source-lattice/crossover;source-hands/drawn
epix2.sourcePath = $(base.sourcePath);source-lattice/epix416;source-hands/drawn
epix2pro47mm.sourcePath = $(base.sourcePath);source-lattice/epix416;source-hands/drawn
epix2pro51mm.sourcePath = $(base.sourcePath);source-lattice/epix454;source-hands/drawn

# What the four hands-drawn watches override, shared between them.
#
# It cannot be a qualified folder. `resources-<device>` would need four copies
# of the same two files, and the family qualifier is no better: epix2pro42mm is
# round-390x390, which is the Crossover's family too, so a family folder would
# reach the one watch these overrides are wrong for.
epix2.resourcePath = $(epix2.resourcePath);resources-drawn-hands
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources-drawn-hands
epix2pro47mm.resourcePath = $(epix2pro47mm.resourcePath);resources-drawn-hands
epix2pro51mm.resourcePath = $(epix2pro51mm.resourcePath);resources-drawn-hands

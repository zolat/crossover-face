<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <setting propertyKey="@Properties.layout" title="@Strings.LayoutTitle" prompt="@Strings.LayoutPrompt">
        <settingConfig type="list">
            <listEntry value="0">@Strings.LayoutBandsBottom</listEntry>
            <listEntry value="1">@Strings.LayoutBandsCentre</listEntry>
            <listEntry value="2">@Strings.LayoutRings</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.handBacking" title="@Strings.BackingTitle" prompt="@Strings.BackingPrompt">
        <settingConfig type="list">
            <listEntry value="0">@Strings.BackingOff</listEntry>
            <listEntry value="1">@Strings.BackingWhite</listEntry>
            <listEntry value="2">@Strings.BackingDark</listEntry>
        </settingConfig>
    </setting>
</settings>

<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- 0 off, 1 white, 2 dark. Kept in sync with StatMap.Backing. -->
    <property id="handBacking" type="number">0</property>
    <!-- 0 show the data in always-on, 1 colour only.
         Kept in sync with StatMap.AlwaysOnFill. -->
    <property id="alwaysOnFill" type="number">0</property>
    <!-- 0 each cross follows its ring, 1 every cross upright.
         Kept in sync with StatMap.Rotation. -->
    <property id="dotRotation" type="number">0</property>
    <!-- Which Source each ring shows. See Source.Kind:
         0 steps, 1 heart rate, 2 battery, 3 body battery,
         4 temperature range, 5 rain chance, 6 intensity minutes,
         7 seconds, 8 off. Seconds reports nothing in always-on. -->
    <property id="ring1" type="number">0</property>
    <property id="ring2" type="number">1</property>
    <property id="ring3" type="number">2</property>
    <property id="ring4" type="number">3</property>
</properties>

<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- 0 Terrain, 1 Activity, 7 Beacon, 8 Pulse. IDs 2-6 are retired and
         reserved; the next production theme must use 9. 99 is Custom: the
         colours a config code delivered, kept in Storage. Kept in sync with
         StatMap.Theme. -->
    <property id="theme" type="number">0</property>
    <!-- 0 off, 1 white, 2 dark. Kept in sync with StatMap.Backing. -->
    <property id="handBacking" type="number">0</property>
    <!-- 0 show the data in always-on, 1 colour only.
         Kept in sync with StatMap.AlwaysOnFill. -->
    <property id="alwaysOnFill" type="number">0</property>
    <!-- 0 each cross follows its ring, 1 every cross upright. 2 is retired:
         it was "upright + date" and reads as upright, the date having become
         showDate below. Kept in sync with StatMap.Rotation. -->
    <property id="dotRotation" type="number">0</property>
    <!-- 0 off, 1 on: the day of the month, outlined through the dots while
         awake (see DateGlyph). Kept in sync with StatMap.DateDisplay. -->
    <property id="showDate" type="number">1</property>
    <!-- 0 50%, 1 65%, 2 80%: how bright the date's connecting lines are,
         against the dots they join. Kept in sync with StatMap.DateOutline. -->
    <property id="dateOutline" type="number">1</property>
    <!-- Which Source each ring shows. See Source.Kind:
         0 steps, 1 retired, 2 battery, 3 body battery,
         4 temperature range, 5 rain chance, 6 intensity minutes,
         7 seconds, 8 off, 9 rain next 12h, 10 UV next 12h,
         11 Body Battery last 12h, 12 temperature next 12h,
         13 temperature range with sunrise and sunset. Seconds reports nothing in always-on.
         Block sources are offered on
         ring1 and ring2 only — the inner two rings have too few dots per hour
         to carry them, and StatMap.load() reads them as off anywhere else.
         New sources are appended after 8
         rather than inserted, so no stored index changes meaning. -->
    <property id="ring1" type="number">0</property>
    <property id="ring2" type="number">1</property>
    <property id="ring3" type="number">2</property>
    <property id="ring4" type="number">3</property>
    <!-- The temperature-ahead ring's scale, in whole degrees Celsius: an hour
         at or below tempAheadLow is an empty block, at or above tempAheadHigh
         a full one. Values, not list indices. -20 to 50; StatMap.load() swaps
         an inverted pair and widens an equal one. -->
    <property id="tempAheadLow" type="number">0</property>
    <property id="tempAheadHigh" type="number">45</property>
    <!-- The whole configuration as one string; see docs/config-code.md.
         Pasting a code here applies it; the watch writes its live
         configuration back into it. Empty until the face first starts. -->
    <property id="configCode" type="string"></property>
</properties>
